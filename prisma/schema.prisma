generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEAM_LEAD
  USER
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String
  passwordHash     String
  role             UserRole       @default(USER)
  twoFactorEnabled Boolean        @default(false)
  twoFactorSecret  String?
  avatarUrl        String?
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  ledTeams         Team[]         @relation("TeamLead")
  buyerTeams       TeamBuyer[]
  farmTasks        FarmTask[]     @relation("FarmTaskCreator")
  fanPageAssets    FanPageAsset[] @relation("FanPageAssetCreator")
}

model Team {
  id            String         @id @default(cuid())
  name          String
  marker        String         @unique
  teamLeadId    String?
  teamLead      User?          @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  buyers        TeamBuyer[]
  fanPageAssets FanPageAsset[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([teamLeadId])
}

model TeamBuyer {
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comment {
  id         String        @id @default(cuid())
  authorName String
  body       String
  status     CommentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
}

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  code3     String   @unique
  numeric   String?
  nameEn    String
  nameRu    String
  flagEmoji String
  flagSvg   String
  region    String?
  createdAt DateTime @default(now())
}

model ActionLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userName  String
  action    String
  detail    String
  level     String   @default("info")
  source    String   @default("adspower")
  profileId String?

  @@index([createdAt])
  @@index([source, createdAt])
}

model FacebookFan {
  id             String   @id @default(cuid())
  adsPowerUserId String
  name           String
  gender         Gender?
  position       Int
  current        Boolean  @default(false)
  syncedAt       DateTime @default(now())

  @@unique([adsPowerUserId, position])
  @@index([adsPowerUserId])
  @@index([gender])
}

enum FarmJobStatus {
  PENDING
  RUNNING
  DONE
  ERROR
}

enum FanPageAssetType {
  AVATAR
  COVER
}

enum Gender {
  ANY
  MALE
  FEMALE
}

model FanPageAsset {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now())
  type            FanPageAssetType
  gender          Gender           @default(ANY)
  geoCode         String
  url             String
  fileName        String
  originalName    String
  mimeType        String
  size            Int
  teamId          String
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?            @relation("FanPageAssetCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([gender])
  @@index([geoCode])
  @@index([teamId])
  @@index([createdAt])
}

model FarmTask {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  createdBy       String
  createdByUserId String?
  createdByUser   User?     @relation("FarmTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  action          String
  total           Int
  jobs            FarmJob[]

  @@index([createdByUserId])
}

model FarmJob {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  status     FarmJobStatus @default(PENDING)
  action     String
  profileId  String
  fanName    String        @default("")
  url        String
  message    String
  aiComment  Boolean       @default(false)
  photoPath  String        @default("")
  error      String?
  taskId     String
  task       FarmTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([taskId, createdAt])
}

model FbAutouploadBindingGroup {
  id        Int                   @id @default(autoincrement())
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  name      String
  bindings  FbAutouploadBinding[]
  uploads   FbAutouploadUpload[]

  @@index([createdAt])
}

model FbAutouploadBinding {
  id        Int                       @id @default(autoincrement())
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  name      String
  createdBy String?
  config    Json
  groupId   Int?
  group     FbAutouploadBindingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([groupId])
}

model FbAutouploadUpload {
  id        Int                       @id @default(autoincrement())
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  name      String
  status    String                    @default("draft")
  payload   Json?
  groupId   Int?
  group     FbAutouploadBindingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([groupId])
  @@index([status])
}
